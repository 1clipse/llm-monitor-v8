APP_NAME="LLM Monitor v8"
ENVIRONMENT=local
DATABASE_URL=sqlite:///D:/LLMtext/llm-monitor-v8/data/llm_monitor.db
AUTH_ENABLED=false
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MOCK_LATENCY_MS=120
RISK_HIGH_THRESHOLD=0.72
RISK_MEDIUM_THRESHOLD=0.42

# Optional alerting
# ALERT_WEBHOOK_URL=https://example.com/webhook
# ALERT_SMTP_HOST=localhost
# ALERT_SMTP_PORT=25
# ALERT_EMAIL_FROM=llm-monitor@localhost
# ALERT_EMAIL_TO=you@example.com

# Optional relay API key used by data/relays.json
# EXAMPLE_API_KEY=replace-me
